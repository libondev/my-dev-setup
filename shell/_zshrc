PROMPT='%F{cyan}%2~%f %# '

alias sc='cd ~/Documents/_code'

# System
alias ll='ls -g'
alias cls='clear'
alias rf='rm -rf '
alias nio='ni --offline'

alias ..='cdBack'
alias ./='codeAlias'
alias claude='claude --dangerously-skip-permissions'

function cdBack() {
  cd ..
  # 打印当前路径
  # print -P "%~"
}

function codeAlias() {
  if [ $# -eq 0 ]; then
    # 如果没有参数，则执行 code ./
    command cursor .
  elif [ $# -eq 1 ]; then
    # 如果只有一个参数，则执行 code $1
    command cursor "$1"
  else
    # 如果有多个参数，则输出错误信息
    echo "Usage: code [path]"
  fi
}

# Node
alias i='pnpm i '
alias x='pnpx -y '
alias r='bun run '
alias d='bun run dev'
alias t='bun run test'
alias s='bun run start'
alias b='bun run build'
alias ci='code . && pnpm i'
alias un='nun '
alias id='ni -D '
alias ig='pnpm i -g '
alias deps='pnpx taze minor -w'
alias xni='npx --no-install '
alias niy='npm init --y'
alias c="open $1 -a \"Cursor\""
alias v="open $1 -a \"Visual Studio Code\""
alias rnm='rm -rf **/node_modules(/)'

# Git
alias gl='git pull'
alias gp='git push'
alias gc='git clone'
alias gs='git checkout -b'
alias gm='git add . && git commit -m'
alias branchs='git branch -a'
alias undo="git reset --soft HEAD^"

# SSH
alias sshgen='ssh-keygen -t ed25519 -C '
alias sshkey='cat ~/.ssh/id_ed25519.pub'

